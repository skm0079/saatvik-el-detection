# File: frontend/Dockerfile.build
FROM node:18-alpine

WORKDIR /app

# Copy package files first (for better Docker layer caching)
COPY package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY . .

# Build the React app (outputs to ../app/static via vite config)
RUN npm run build

# Keep container running briefly to ensure build completes
CMD ["echo", "Frontend build completed successfully"]